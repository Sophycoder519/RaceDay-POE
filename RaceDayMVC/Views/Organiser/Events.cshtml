@model List<dynamic>
@{
    ViewData["Title"] = "My Events";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center">
        <h2>My Events</h2>
        <a asp-action="CreateEvent" class="btn btn-success">+ Create New Event</a>
    </div>

    <table class="table table-striped mt-4">
        <thead>
            <tr>
                <th>Title</th>
                <th>Date</th>
                <th>Location</th>
                <th>Type</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ev in Model)
            {
                <tr>
                    <td>@ev.title</td>
                    <td>@ev.eventDate</td>
                    <td>@ev.eventType</td>
                    <td>
                        <form asp-action="UploadBanner" method="post" enctype="multipart/form-data" class="d-inline">
                            <input type="hidden" name="eventId" value="@ev.eventID" />
                            <input type="file" name="banner" class="form-control form-control-sm d-inline" style="width:130px;" required />
                            <button type="submit" class="btn btn-sm btn-info">Img</button>
                        </form>
                        <a asp-action="Categories" asp-route-eventId="@ev.eventID" class="btn btn-sm btn-secondary">Cats</a>
                        <a asp-action="Enrolments" asp-route-eventId="@ev.eventID" class="btn btn-sm btn-warning">Enrols</a>
                        <a asp-action="Results" asp-route-eventId="@ev.eventID" class="btn btn-sm btn-success">Results</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>