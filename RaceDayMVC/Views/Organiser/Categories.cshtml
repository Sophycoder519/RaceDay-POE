@model List<dynamic>
@{
    ViewData["Title"] = "Manage Categories"; int eventId = ViewBag.EventId;
}
<div class="container mt-4">
    <h2>Manage Categories (Event ID: @eventId)</h2>
    <a asp-action="Events" class="btn btn-secondary mb-3">Back to Events</a>
    <div class="card mb-4">
        <div class="card-body">
            <h5>Add New Category</h5>
            <form asp-action="CreateCategory" method="post" class="row g-3">
                <input type="hidden" name="eventId" value="@eventId" />
                <input type="hidden" name="EventID" value="@eventId" />
                <div class="col-md-3"><input type="text" name="Name" class="form-control" placeholder="Name (e.g. 10km)" required /></div>
                <div class="col-md-2"><input type="number" step="0.1" name="Distance" class="form-control" placeholder="Distance" required /></div>
                <div class="col-md-2"><input type="number" name="EntryFee" class="form-control" placeholder="Fee" required /></div>
                <div class="col-md-3"><input type="time" name="StartTime" class="form-control" required /></div>
                <div class="col-md-2"><button type="submit" class="btn btn-success w-100">Add</button></div>
            </form>
        </div>
    </div>
    <ul class="list-group">
        @foreach (var cat in Model)
        {
            <li class="list-group-item"><strong>@cat.name</strong> - @cat.distance KM (R@cat.entryFee)</li>
        }
    </ul>
</div>