@model List<dynamic>
@{
    ViewData["Title"] = "My Enrolments";
}
<div class="container mt-4">
    <h2>My Enrolments</h2>
    <table class="table table-striped">
        <thead><tr><th>Event</th><th>Category</th><th>Status</th></tr></thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.event.title</td>
                    <td>@e.category.name</td>
                    <td><span class="badge @(e.status == "Confirmed" ? "bg-success" : "bg-warning text-dark")">@e.status</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>