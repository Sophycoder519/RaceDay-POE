@model List<dynamic>
@{
    ViewData["Title"] = "My Results";
}

<div class="container mt-4">
    <h2>My Race Results</h2>
    <div class="alert alert-info">Raw data from API:</div>
    <pre class="bg-light p-3 border rounded" style="max-height: 500px; overflow-y: auto;">@System.Text.Json.JsonSerializer.Serialize(Model, new System.Text.Json.JsonSerializerOptions { WriteIndented = true })</pre>
</div>
